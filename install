# Tool Name :- IP-Tracer
# Author :- Codizium

if [ -e /usr/bin/dnf ];then
  if [ ! -e /usr/bin/php ];then
    sudo dnf makecache
    sudo dnf install -y php-cli || sudo dnf install -y php
  fi
elif [ -e  /usr/lib/sudo ];then

  if [ ! -e /usr/bin/php ];then
     sudo apt-get update
     sudo apt-get upgrade -y
     sudo apt-get install php8.4 -y || sudo apt-get install php -y
   fi
else
  if [ -d /usr/bin ];then
    if [ ! -e /usr/bin/php ];then
     apt-get update
     apt-get upgrade -y
     apt-get install php8.4 -y || apt-get install php -y
    fi
  fi
fi
if [ ! -d /usr/bin ];then
  if [ ! -e /data/data/com.termux/files/usr/bin/php ];then
    pkg update
    pkg upgrade -y
    pkg install php -y
  fi
fi
php .setup.php
exit
